# Local settings. Loaded into the Airflow containers by `astro dev start` and auto-loaded by the dbt CLI (dbt >= 1.12).
# Keep machine-specific paths out of here: container paths are set in the Dockerfile, local runs use repo-relative defaults.

# === dbt ===
DBT_TARGET=dev
# Optional: dbt binary used by Cosmos. Leave unset to use the dbt installed alongside Airflow.
# DBT_EXECUTABLE_PATH=

# === Optional path overrides (defaults: data/parquet and ecomerce/) ===
# OLIST_PARQUET_DIR=
# DUCKDB_DIR=

# === GCP / BigQuery (future: not used until the BigQuery loader is enabled) ===
GCP_PROJECT_ID=
BQ_DATASET_RAW=raw
BQ_DATASET_DBT=
BQ_LOCATION=US
# Read natively by the Google client libraries (Application Default Credentials).
GOOGLE_APPLICATION_CREDENTIALS=
